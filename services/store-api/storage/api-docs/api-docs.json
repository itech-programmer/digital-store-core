{
    "openapi": "3.0.0",
    "info": {
        "title": "Digital Store Core API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local Docker"
        }
    ],
    "paths": {
        "/api/v1/admin/reconcile": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Сверка ledger",
                "description": "Находит расхождения: оплаченные но не выданные, выданные без оплаты. Проверяет баланс financial_ledger.",
                "operationId": "adminReconcile",
                "responses": {
                    "200": {
                        "description": "Отчет сверки",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReconcileResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверный или отсутствующий X-Admin-Token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/admin/recover": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Recovery зависших заказов",
                "description": "Сбрасывает stale delivering и повторяет выдачу для paid/out_of_stock/delivery_failed.",
                "operationId": "adminRecover",
                "parameters": [
                    {
                        "name": "stale_minutes",
                        "in": "query",
                        "description": "Через сколько минут delivering считается зависшим",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 10,
                            "default": 10,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Результат recovery",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RecoveryResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверный или отсутствующий X-Admin-Token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/catalog/stock": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Витрина: SKU и остатки",
                "description": "Пагинированный список активных SKU с остатком из product_stock_cache (без COUNT по product_keys на каждый запрос).",
                "operationId": "catalogStock",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 100,
                            "default": 100,
                            "maximum": 200,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список SKU",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogStockResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "description": "Проверка доступности API.",
                "operationId": "healthCheck",
                "responses": {
                    "200": {
                        "description": "Сервис доступен",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "service": {
                                            "type": "string",
                                            "example": "digital-store-core"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/orders": {
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Создать заказ",
                "description": "Создает заказ по SKU. Если webhook пришел раньше заказа - pending события будут обработаны автоматически.",
                "operationId": "createOrder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateOrderRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Заказ создан",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "SKU не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Получить заказ",
                "description": "Возвращает статус заказа и выданный код (если delivered).",
                "operationId": "getOrder",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Публичный ID заказа",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "ord_abc123xyz0"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Заказ найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Заказ не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/webhook/payment": {
            "post": {
                "tags": [
                    "Payment"
                ],
                "summary": "Платежный webhook",
                "description": "Обрабатывает событие paid/failed. Idempotent по event_id: повтор с тем же event_id не выдает код дважды.",
                "operationId": "paymentWebhook",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PaymentWebhookRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Событие принято",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WebhookAcceptedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "503": {
                        "description": "Внутренняя ошибка обработки",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateOrderRequest": {
                "required": [
                    "sku"
                ],
                "properties": {
                    "sku": {
                        "description": "SKU товара",
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "public_id": {
                        "type": "string",
                        "example": "ord_abc123xyz0",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Order": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "ord_abc123xyz0"
                    },
                    "sku": {
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 1500
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "status": {
                        "type": "string",
                        "example": "delivered"
                    },
                    "issued_code": {
                        "type": "string",
                        "example": "CODE-123",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "paid_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "delivered_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "OrderResponse": {
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Order"
                    }
                },
                "type": "object"
            },
            "ErrorMessage": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "SKU not found"
                    }
                },
                "type": "object"
            },
            "PaymentWebhookRequest": {
                "required": [
                    "event_id",
                    "order_id",
                    "status",
                    "amount",
                    "currency",
                    "created_at"
                ],
                "properties": {
                    "event_id": {
                        "type": "string",
                        "example": "evt_001"
                    },
                    "order_id": {
                        "type": "string",
                        "example": "ord_abc123xyz0"
                    },
                    "status": {
                        "type": "string",
                        "example": "paid",
                        "enum": [
                            "paid",
                            "failed"
                        ]
                    },
                    "amount": {
                        "type": "integer",
                        "example": 1500
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-01T12:00:00Z"
                    }
                },
                "type": "object"
            },
            "WebhookAcceptedResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "accepted"
                    }
                },
                "type": "object"
            },
            "CatalogStockItem": {
                "properties": {
                    "sku": {
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "name": {
                        "type": "string",
                        "example": "CS2 Prime"
                    },
                    "type": {
                        "type": "string",
                        "example": "key"
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 1500
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "stock": {
                        "type": "integer",
                        "example": 42
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 100
                    },
                    "total": {
                        "type": "integer",
                        "example": 5000
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 50
                    }
                },
                "type": "object"
            },
            "CatalogStockResponse": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CatalogStockItem"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginationMeta"
                    }
                },
                "type": "object"
            },
            "ReconcileResponse": {
                "properties": {
                    "paid_not_delivered": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "delivered_not_paid": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "ledger_balanced": {
                        "type": "boolean",
                        "example": true
                    },
                    "ledger_payment_sum": {
                        "type": "number",
                        "format": "float"
                    },
                    "ledger_delivery_sum": {
                        "type": "number",
                        "format": "float"
                    },
                    "generated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "RecoveryResponse": {
                "properties": {
                    "recovered": {
                        "type": "integer",
                        "example": 2
                    },
                    "order_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "AdminToken": {
                "type": "apiKey",
                "description": "Admin token. По умолчанию: dev-admin-token",
                "name": "X-Admin-Token",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Health",
            "description": "Проверка доступности сервиса"
        },
        {
            "name": "Orders",
            "description": "Создание и просмотр заказов"
        },
        {
            "name": "Payment",
            "description": "Платежные webhook от провайдера"
        },
        {
            "name": "Catalog",
            "description": "Витрина: SKU, цены и остатки"
        },
        {
            "name": "Admin",
            "description": "Сверка ledger и recovery (X-Admin-Token)"
        }
    ]
}