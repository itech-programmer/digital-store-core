{
    "openapi": "3.0.0",
    "info": {
        "title": "Digital Store Core API",
        "description": "Этапы 1-2: multi-item orders, partial/refund, untrusted supplier, admin reconcile/recover, rate-limit progress, point-in-time.",
        "version": "2.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local Docker"
        }
    ],
    "paths": {
        "/api/v1/admin/delivery-progress": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Прогресс выдачи",
                "description": "Глубина очереди delivery и счётчики выдачи (задача 3).",
                "operationId": "adminDeliveryProgress",
                "responses": {
                    "200": {
                        "description": "Снимок прогресса",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DeliveryProgressResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверный или отсутствующий X-Admin-Token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/admin/finance/period": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Finance period totals",
                "description": "Итоги financial_ledger за период (задача 4).",
                "operationId": "adminFinancePeriod",
                "parameters": [
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Итоги периода",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FinancePeriodResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/admin/orders/{id}/as-of": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Order as-of",
                "description": "Восстанавливает состояние заказа на момент времени из domain_events + ledger (задача 4).",
                "operationId": "adminOrderAsOf",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "at",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Снимок на момент",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderAsOfResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/admin/reconcile": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Сверка ledger",
                "description": "Находит расхождения статусов и проверяет инвариант paid = delivered + refunded в financial_ledger.",
                "operationId": "adminReconcile",
                "responses": {
                    "200": {
                        "description": "Отчет сверки",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReconcileResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверный или отсутствующий X-Admin-Token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/admin/recover": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Recovery зависших заказов",
                "description": "Line-aware recovery: сбрасывает stale delivering и дожимает выдачу/refund.",
                "operationId": "adminRecover",
                "parameters": [
                    {
                        "name": "stale_minutes",
                        "in": "query",
                        "description": "Через сколько минут delivering считается зависшим",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 10,
                            "default": 10,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Результат recovery",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RecoveryResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверный или отсутствующий X-Admin-Token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "AdminToken": []
                    }
                ]
            }
        },
        "/api/v1/catalog/stock": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Витрина: SKU и остатки",
                "description": "Пагинированный список активных SKU с остатком из product_stock_cache.",
                "operationId": "catalogStock",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 100,
                            "default": 100,
                            "maximum": 200,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список SKU",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogStockResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                }
            }
        },
        "/api/v1/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "description": "Проверка доступности API.",
                "operationId": "healthCheck",
                "responses": {
                    "200": {
                        "description": "Сервис доступен",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "service": {
                                            "type": "string",
                                            "example": "digital-store-core"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/orders": {
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Создать заказ",
                "description": "Создаёт заказ: items[{sku,qty}] или legacy sku. Pending webhook до создания заказа применится автоматически.",
                "operationId": "createOrder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateOrderRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Заказ создан",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "SKU не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Получить заказ",
                "description": "Возвращает заказ: header status, amount, items[] (status/issued_code/supplier per line).",
                "operationId": "getOrder",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Публичный ID заказа",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "ord_abc123xyz0"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Заказ найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Заказ не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/webhook/payment": {
            "post": {
                "tags": [
                    "Payment"
                ],
                "summary": "Платежный webhook",
                "description": "Обрабатывает событие paid/failed. Idempotent по event_id: повтор с тем же event_id не выдает код дважды.",
                "operationId": "paymentWebhook",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PaymentWebhookRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Событие принято",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WebhookAcceptedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "503": {
                        "description": "Внутренняя ошибка обработки",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateOrderRequest": {
                "properties": {
                    "sku": {
                        "description": "SKU одного товара (legacy). Либо sku, либо items.",
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "items": {
                        "description": "Позиции заказа (задача 1 этапа 2: несколько товаров)",
                        "type": "array",
                        "items": {
                            "required": [
                                "sku"
                            ],
                            "properties": {
                                "sku": {
                                    "type": "string",
                                    "example": "KEY-CS2-PRIME"
                                },
                                "qty": {
                                    "type": "integer",
                                    "example": 1
                                }
                            },
                            "type": "object"
                        }
                    },
                    "public_id": {
                        "type": "string",
                        "example": "ord_abc123xyz0",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "OrderItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "sku": {
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 1
                    },
                    "unit_price": {
                        "type": "number",
                        "format": "float",
                        "example": 1290
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 1290
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "status": {
                        "type": "string",
                        "example": "pending"
                    },
                    "issued_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "supplier": {
                        "type": "string",
                        "example": "primary",
                        "nullable": true
                    },
                    "delivered_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "refunded_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Order": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "ord_abc123xyz0"
                    },
                    "sku": {
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 1500
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "status": {
                        "description": "created|paid|delivering|delivered|partially_delivered|refunded|payment_failed|...",
                        "type": "string",
                        "example": "partially_delivered"
                    },
                    "issued_code": {
                        "description": "Legacy single-item; для multi-item смотри items[].issued_code",
                        "type": "string",
                        "example": "CODE-123",
                        "nullable": true
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "paid_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "delivered_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "OrderResponse": {
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Order"
                    }
                },
                "type": "object"
            },
            "ErrorMessage": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "SKU not found"
                    }
                },
                "type": "object"
            },
            "PaymentWebhookRequest": {
                "required": [
                    "event_id",
                    "order_id",
                    "status",
                    "amount",
                    "currency",
                    "created_at"
                ],
                "properties": {
                    "event_id": {
                        "type": "string",
                        "example": "evt_001"
                    },
                    "order_id": {
                        "type": "string",
                        "example": "ord_abc123xyz0"
                    },
                    "status": {
                        "type": "string",
                        "example": "paid",
                        "enum": [
                            "paid",
                            "failed"
                        ]
                    },
                    "amount": {
                        "type": "integer",
                        "example": 1500
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-01T12:00:00Z"
                    }
                },
                "type": "object"
            },
            "WebhookAcceptedResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "accepted"
                    }
                },
                "type": "object"
            },
            "CatalogStockItem": {
                "properties": {
                    "sku": {
                        "type": "string",
                        "example": "KEY-CS2-PRIME"
                    },
                    "name": {
                        "type": "string",
                        "example": "CS2 Prime"
                    },
                    "type": {
                        "type": "string",
                        "example": "key"
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 1500
                    },
                    "currency": {
                        "type": "string",
                        "example": "RUB"
                    },
                    "stock": {
                        "type": "integer",
                        "example": 42
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 100
                    },
                    "total": {
                        "type": "integer",
                        "example": 5000
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 50
                    }
                },
                "type": "object"
            },
            "CatalogStockResponse": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CatalogStockItem"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginationMeta"
                    }
                },
                "type": "object"
            },
            "ReconcileResponse": {
                "properties": {
                    "paid_not_delivered": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "delivered_not_paid": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "unbalanced_orders": {
                        "description": "Заказы где paid != delivered + refunded",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "ledger_balanced": {
                        "type": "boolean",
                        "example": true
                    },
                    "ledger_payment_sum": {
                        "type": "number",
                        "format": "float"
                    },
                    "ledger_delivery_sum": {
                        "type": "number",
                        "format": "float"
                    },
                    "ledger_refund_sum": {
                        "type": "number",
                        "format": "float"
                    },
                    "generated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "RecoveryResponse": {
                "properties": {
                    "recovered": {
                        "type": "integer",
                        "example": 2
                    },
                    "order_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
            },
            "DeliveryProgressResponse": {
                "properties": {
                    "queue_depth": {
                        "type": "integer"
                    },
                    "orders_paid_waiting": {
                        "type": "integer"
                    },
                    "orders_delivering": {
                        "type": "integer"
                    },
                    "orders_delivered": {
                        "type": "integer"
                    },
                    "orders_partially_delivered": {
                        "type": "integer"
                    },
                    "items_delivered": {
                        "type": "integer"
                    },
                    "items_pending": {
                        "type": "integer"
                    },
                    "generated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "OrderAsOfResponse": {
                "properties": {
                    "as_of": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "order": {
                        "type": "object"
                    },
                    "money": {
                        "type": "object"
                    },
                    "events_applied": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "FinancePeriodResponse": {
                "properties": {
                    "from": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "to": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "payment_received": {
                        "type": "number"
                    },
                    "delivery_completed": {
                        "type": "number"
                    },
                    "refund_issued": {
                        "type": "number"
                    },
                    "net": {
                        "type": "number"
                    },
                    "counts": {
                        "type": "object"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "AdminToken": {
                "type": "apiKey",
                "description": "Admin token. По умолчанию: dev-admin-token",
                "name": "X-Admin-Token",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Health",
            "description": "Проверка доступности сервиса"
        },
        {
            "name": "Orders",
            "description": "Создание и просмотр заказов (items[] / legacy sku)"
        },
        {
            "name": "Payment",
            "description": "Платежные webhook от провайдера"
        },
        {
            "name": "Catalog",
            "description": "Витрина: SKU, цены и остатки"
        },
        {
            "name": "Admin",
            "description": "Reconcile, recovery, delivery-progress, as-of, finance period (X-Admin-Token)"
        }
    ]
}